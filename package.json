{
  "name": "ante",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 33333",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
