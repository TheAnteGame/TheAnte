# ANTE — environment
# Copy to .env.local for development. Set the real values in Vercel for preview/production.
# NEVER commit .env.local. The repo is public.
# Decisions referenced below live in docs/DECISIONS.md.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project: TheAnte (ref vyhxslqddjyyrgbmaedn, us-west-2)
# Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://vyhxslqddjyyrgbmaedn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never import into a client component. Used exclusively inside server
# actions that have already passed a commissioner check (ANTE-ADMIN.md §1).
# Note: this key does NOT bypass the ticket blackout — RLS and the immutability
# trigger apply to it too. That is deliberate and tested (acceptance tests 1, 2).
SUPABASE_SERVICE_ROLE_KEY=

# ── Clerk (phone OTP, passwordless — DECISIONS.md D-001) ──────────────────────
# Clerk project: "The Ante"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Sports data (DECISIONS.md D-005) ──────────────────────────────────────────
# No keys needed. nflverse games.csv supplies schedule + frozen spreads; ESPN's
# public scoreboard supplies live status and finals, joined on nflverse's espn id.
# SportsDataIO is the documented paid fallback behind lib/sports/ — if adopted:
# SPORTSDATAIO_API_KEY=

# ── Email (Resend — all notifications season one, DECISIONS.md D-001) ─────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@theantegame.com

# ── Jobs ──────────────────────────────────────────────────────────────────────
# Shared secret for Vercel Cron endpoints. Generate with: openssl rand -hex 32
# Every /api/jobs/* route rejects requests without it.
CRON_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Twilio — DEFERRED, DO NOT REMOVE (DECISIONS.md D-001) ─────────────────────
# SMS waits on A2P 10DLC approval; lib/notify/sms.ts is a stub until then.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
